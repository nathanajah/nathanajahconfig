{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": "notify",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "rm -rf *": "deny",
      "rm -rf/*": "deny",
      "sops *": "ask",
      "sops --rotate*": "ask",
      "sops -d *": "ask",
      "sops --decrypt *": "ask",
      "sops -e *": "allow",
      "sops --encrypt *": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "git remote -v*": "allow",
      "git remote show*": "allow",
      "git branch --show-current*": "allow",
      "git branch --list*": "allow",
      "git branch -l*": "allow",
      "git branch -v*": "allow",
      "git config --get*": "allow",
      "ls*": "allow",
      "pwd": "allow"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/sops/**": "deny"
    }
  }
}
