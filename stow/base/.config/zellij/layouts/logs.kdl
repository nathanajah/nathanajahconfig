layout {
    tab name="logs" focus=true {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="vertical" size="80%" {
            pane name="host1"
            pane name="host2"
            pane name="host3"
        }
        pane size="20%" name="shell"
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
}
